{
  "name": "employeeclient",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --tunnel",
    "startrelease": "npx expo start -c --tunnel --no-dev --minify",
    "build": "eas build --platform all",
    "prebuild": "npx expo prebuild && pod install --project-directory=./ios --clean-install",
    "buildios": "eas build --platform ios",
    "buildandroid": "eas build --platform android",
    "publish": "npx expo publish",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npx expo start --web",
    "cleanstart": "npx expo start -c"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@tanstack/react-query": "^5.59.15",
    "expo": "~51.0.38",
    "expo-splash-screen": "~0.27.4",
    "expo-status-bar": "~1.12.1",
    "expo-localization": "~15.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-country-picker-modal": "^2.x",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-stars": "^1.2.2",
    "zustand": "^4.5.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo-secure-store": "~13.0.2",
    "expo-local-authentication": "~14.0.1",
    "react-native-safe-area-context": "4.10.5",
    "expo-image": "~1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@types/lodash": "^4.17.6",
    "@types/react": "~18.2.79",
    "babel-plugin-module-resolver": "^5.0.2",
    "react-native-dotenv": "^3.4.11",
    "react-native-reanimated": "~3.10.1",
    "react-native-svg-transformer": "^1.4.0",
    "typescript": "~5.3.3"
  },
  "private": true
